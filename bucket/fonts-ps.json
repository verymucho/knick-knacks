{
    "version": "1.1.27",
    "description": "PowerShell module for managing fonts",
    "homepage": "https://github.com/PSModule/Fonts",
    "license": "MIT",
    "url": "https://cdn.powershellgallery.com/packages/fonts.1.1.27.nupkg",
