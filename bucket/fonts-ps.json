    "pre_install": "Remove-Item \"$dir\\_rels\", \"$dir\\package\", \"$dir\\*Content*.xml\", \"$dir\\*.nuspec\" -Recurse",
    "psmodule": {
        "name": "Fonts"
    },
    "checkver": {
        "url": "https://www.powershellgallery.com/packages/Fonts",
        "regex": "<h2>([\\d.]+)</h2>"
    },
    "autoupdate": {
        "url": "https://cdn.powershellgallery.com/packages/fonts.$version.nupkg"
    }
}
