{
    "version": "2611.2871.0",
    "description": "Find the latest version and download URL for various Windows apps (Evergreen alternative)",
    "homepage": "https://github.com/EUCPilots/evergreen-module",
    "license": "MIT",
    "url": "https://github.com/EUCPilots/evergreen-module/archive/refs/tags/v2611.2871.0.zip",
    "hash": "c48aa20d5e02d0e4ce00549315c85132282a8d44f4885105f0f0f822d4ea0ec7",
    "extract_dir": "evergreen-module-2611.2871.0\\Evergreen",
    "psmodule": {
        "name": "Evergreen"
    },
    "post_install": [
        "$Env:EVERGREEN_APPS_PATH = \"$dir\\Apps\"",
        "Import-Module \"$dir\\Evergreen.psd1\"",
        "Update-Evergreen"
    ],
    "env_set": {
        "EVERGREEN_APPS_PATH": "$dir\\Apps"
    },
    "persist": "Apps",
    "checkver": {
        "url": "https://api.github.com/repos/EUCPilots/evergreen-module/tags",
        "jsonpath": "$[0].name",
        "regex": "(?i)v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/EUCPilots/evergreen-module/archive/refs/tags/v$version.zip",
        "extract_dir": "evergreen-module-$version\\Evergreen"
    }
}
